#!/bin/bash
#SBATCH --job-name=mtlmar_mtl_attn
#SBATCH --nodes=1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-node=1
#SBATCH --mem=64000
#SBATCH --time=36:00:00
#SBATCH --output=/gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2/outfiles/train_mtl_attn_%j.out
#SBATCH --error=/gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2/errfiles/train_mtl_attn_%j.err
#SBATCH --partition=gpu
set -euo pipefail
export OMP_NUM_THREADS=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg
export MASKED_FEATURE_VARIANT=attention
ROOT=/gxfs_work/cau/sunms498/work/mtl-mar
PY="${PYTORCH_PYTHON:-${HOME}/.conda/envs/pytorch/bin/python}"
export PATH="$(dirname "$PY"):$PATH"
mkdir -p "/gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2/outfiles" "/gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2/errfiles"
cd "/gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2"
echo "=== train_multi_task_learning_attention.ipynb started: $(date) ==="
"$PY" -c "import torch; print('cuda', torch.cuda.is_available())"
"$PY" -m jupyter nbconvert --to notebook --execute --inplace \
  --ExecutePreprocessor.timeout=86400 --ExecutePreprocessor.kernel_name=python3 \
  train_multi_task_learning_attention.ipynb
echo "=== finished: $(date) ==="
