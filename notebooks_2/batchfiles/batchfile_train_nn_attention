#!/bin/bash
# Full train → test → chunked world map for FFNN+attention (paper Table 2 recipe).
# Submit from anywhere:
#   sbatch /gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2/batchfiles/batchfile_train_nn_attention
#
#SBATCH --job-name=mtlmar_attn
#SBATCH --nodes=1
#SBATCH --tasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-node=1
#SBATCH --mem=64000
#SBATCH --time=24:00:00
#SBATCH --output=/gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2/outfiles/train_nn_attention_%j.out
#SBATCH --error=/gxfs_work/cau/sunms498/work/mtl-mar/notebooks_2/errfiles/train_nn_attention_%j.err
#SBATCH --partition=gpu

set -euo pipefail
export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export MPLBACKEND=Agg
export MASKED_FEATURE_VARIANT=attention

ROOT=/gxfs_work/cau/sunms498/work/mtl-mar
NB="$ROOT/notebooks_2"
PY="${PYTORCH_PYTHON:-${HOME}/.conda/envs/pytorch/bin/python}"
export PATH="$(dirname "$PY"):$PATH"

mkdir -p "$NB/outfiles" "$NB/errfiles"
cd "$NB"

echo "=== train_neural_network_attention started: $(date) ==="
echo "Node: $(hostname)  Job: ${SLURM_JOB_ID:-local}  GPU: ${CUDA_VISIBLE_DEVICES:-all}"
echo "Python: $PY"
"$PY" -c "import torch; print('cuda', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)"

"$PY" -m jupyter nbconvert --to notebook --execute --inplace \
  --ExecutePreprocessor.timeout=86400 \
  --ExecutePreprocessor.kernel_name=python3 \
  train_neural_network_attention.ipynb

echo "=== finished: $(date) ==="
